{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "base": {
      "node": "24.22.0",
      "pnpm": "12.14.0",
      "ios": {
        "image": "latest"
      }
    },
    "development": {
      "extends": "base",
      "env": {
        "APP_VARIANT": "development"
      },
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "extends": "base",
      "env": {
        "APP_VARIANT": "preview"
      },
      "environment": "preview",
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "extends": "base",
      "env": {
        "APP_VARIANT": "production"
      },
      "environment": "production",
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6824624497"
      }
    }
  }
}
