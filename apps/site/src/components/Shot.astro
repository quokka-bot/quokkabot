---
// A real screenshot of the app. Wide screens get the desktop capture; phones get the app's own phone layout when one
// is given, because a desktop capture shrunk to phone width is too small to read.
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

interface Props {
  wide: ImageMetadata;
  narrow?: ImageMetadata;
  alt: string;
  sizes: string;
  eager?: boolean;
}

const { wide, narrow, alt, sizes, eager = false } = Astro.props;
const PHONE = "(max-width: 760px)";

async function variants(image: ImageMetadata, widths: number[], format: "avif" | "webp") {
  const usable = widths.filter((width) => width <= image.width);
  const images = await Promise.all(usable.map((width) => getImage({ src: image, width, format, quality: 86 })));
  return images.map((result) => `${result.src} ${result.attributes.width}w`).join(", ");
}

const wideWidths = [480, 800, 1120, 1600, 2240, 2880];
const narrowWidths = [390, 780, 1170, 1290];
const wideAvif = await variants(wide, wideWidths, "avif");
const wideWebp = await variants(wide, wideWidths, "webp");
const narrowAvif = narrow ? await variants(narrow, narrowWidths, "avif") : null;
const narrowWebp = narrow ? await variants(narrow, narrowWidths, "webp") : null;
const fallback = await getImage({ src: wide, width: Math.min(1120, wide.width), format: "webp", quality: 86 });
---

<picture>
  {narrow && narrowAvif && <source media={PHONE} srcset={narrowAvif} sizes="92vw" width={narrow.width} height={narrow.height} type="image/avif" />}
  {narrow && narrowWebp && <source media={PHONE} srcset={narrowWebp} sizes="92vw" width={narrow.width} height={narrow.height} type="image/webp" />}
  <source srcset={wideAvif} sizes={sizes} width={wide.width} height={wide.height} type="image/avif" />
  <source srcset={wideWebp} sizes={sizes} width={wide.width} height={wide.height} type="image/webp" />
  <img
    src={fallback.src}
    width={wide.width}
    height={wide.height}
    alt={alt}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
    decoding="async"
  />
</picture>
