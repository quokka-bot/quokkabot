{
  "name": "@quokkabot/desktop",
  "version": "0.2.1",
  "license": "MIT",
  "productName": "Quokka Bot",
  "private": true,
  "type": "module",
  "description": "Quokka Bot desktop app",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node scripts/build.mjs && electron .",
    "dist:mac": "node scripts/build.mjs && electron-builder --config electron-builder.config.cjs --mac --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@quokkabot/shared": "workspace:*",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  }
}
