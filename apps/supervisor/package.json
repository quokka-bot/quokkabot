    "start": "node dist/main.js"
  },
  "dependencies": {
    "@quokkabot/shared": "workspace:*",
    "zod": "4.6.7",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.2"
  }
}
